<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="AngleAlign">
    <Sequence>
      <AverageAiDetection num_retries="5"
                          buffer_size="5"
                          average_obj="{aiObj}"
                          classification="{classification}"
                          camera="0"/>
      <IfThenElse>
        <GetAngle error_margin="0.100000"
                  ideal_ratio="1"
                  detected_angle="{angle1}"
                  aiObj="{aiObj}"/>
        <AlwaysSuccess/>
        <Sequence>
          <SubTree ID="MoveSinglePose"
                   positionX="0.0"
                   positionY="0.0"
                   positionZ="0.0"
                   orientationX="0.0"
                   orientationY="0.0"
                   orientationZ="5"
                   frame="1"
                   _autoremap="true"/>
          <AverageAiDetection num_retries="5"
                              buffer_size="5"
                              average_obj="{aiObj}"
                              classification="{classification}"
                              camera="0"/>
          <Fallback>
            <GetAngle error_margin="0.100000"
                      ideal_ratio="1"
                      detected_angle="{angle2}"
                      aiObj="{aiObj}"/>
            <IfThenElse>
              <ScriptCondition code="angle1&gt;angle2"/>
              <Sequence>
                <SubTree ID="MoveSinglePose"
                         positionX="0.0"
                         positionY="0.0"
                         positionZ="0.0"
                         orientationX="0.0"
                         orientationY="0.0"
                         orientationZ="{angle1}"
                         frame="1"
                         _autoremap="true"/>
              </Sequence>
              <SubTree ID="MoveSinglePose"
                       positionX="0.0"
                       positionY="0.0"
                       positionZ="0.0"
                       orientationX="0.0"
                       orientationY="0.0"
                       orientationZ="{angle2}"
                       frame="1"
                       _autoremap="true"/>
            </IfThenElse>
          </Fallback>
        </Sequence>
      </IfThenElse>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="ApprocheTarget">
    <Sequence>
      <AverageAiDetection num_retries="5"
                          buffer_size="5"
                          average_obj="{target}"
                          classification="{classification}"
                          camera="0"/>
      <InitTraj trajectory="{traj}"/>
      <MoveToTarget trajectory="{traj}"
                    offset="{offset}"
                    aiObj="{target}"/>
      <SendTrajToPlanner trajectory="{traj}"
                         interpolation="0"/>
      <WaitTargetReached timeout="5"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="RotAlignZ">
    <Sequence>
      <InitTraj trajectory="{traj}"/>
      <Fallback>
        <CheckRotationZAlign pixel_to_degrees="{pixel_to_degrees}"
                             error_margin="{error_margin}"
                             target_x="{target_x}"
                             traj="{traj}"
                             detection_object="{detection_object}"/>
        <Sequence>
          <SendTrajToPlanner trajectory="{traj}"
                             interpolation="0"/>
          <WaitTargetReached timeout="5"/>
        </Sequence>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="StepApproachUntilLoss">
    <WhileDoElse>
      <AverageAiDetection num_retries="5"
                          buffer_size="5"
                          average_obj="{step_obj}"
                          classification="{classification}"
                          camera="0"/>
      <Sequence>
        <SubTree ID="RotAlignZ"
                 detection_object="{step_obj}"
                 target_x="300"
                 error_margin="0.05"
                 pixel_to_degrees="0.0676"
                 _autoremap="true"/>
        <SubTree ID="MoveSinglePose"
                 positionX="1.5"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="0.0"
                 frame="1"
                 _autoremap="true"/>
      </Sequence>
      <AlwaysSuccess/>
    </WhileDoElse>
  </BehaviorTree>

  <BehaviorTree ID="StepApproachUntilSuccess">
    <RetryUntilSuccessful num_attempts="6">
      <Fallback>
        <RetryUntilSuccessful num_attempts="8">
          <CheckAiInfo max_count="1"
                       ai_info="{step_ob_arr}"
                       confidence="{confidence}"
                       camera="1"
                       min_count="1"
                       classification="{classification}"/>
        </RetryUntilSuccessful>
        <ForceFailure>
          <SubTree ID="MoveSinglePose"
                   positionX="1"
                   positionY="0.0"
                   positionZ="0.0"
                   orientationX="0.0"
                   orientationY="0.0"
                   orientationZ="0.0"
                   frame="1"
                   _autoremap="true"/>
        </ForceFailure>
      </Fallback>
    </RetryUntilSuccessful>
  </BehaviorTree>

  <BehaviorTree ID="TransAlignXY">
    <Sequence>
      <InitTraj trajectory="{transAlign}"/>
      <Fallback>
        <CheckTranslationXYAlign traj="{transAlign}"
                                 error_margin="{error_margin}"
                                 target_y="{target_y}"
                                 target_x="{target_x}"
                                 distance="{dist}"
                                 detection_object="{detection_object}"/>
        <Sequence>
          <SendTrajToPlanner trajectory="{transAlign}"
                             interpolation="0"/>
          <WaitTargetReached timeout="5"/>
        </Sequence>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="TransAlignYZ">
    <Sequence>
      <InitTraj trajectory="{transAlign}"/>
      <Fallback>
        <CheckTranslationYZAlign error_margin="{error_margin}"
                                 target_y="{target_y}"
                                 target_x="{target_x}"
                                 traj="{transAlign}"
                                 detection_object="{detection_object}"/>
        <Sequence>
          <SendTrajToPlanner trajectory="{transAlign}"
                             interpolation="0"/>
          <WaitTargetReached timeout="5"/>
        </Sequence>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AverageAiDetection">
      <input_port name="num_retries"
                  default="5"
                  type="int">Number of invalid detection allowed between good ones</input_port>
      <input_port name="buffer_size"
                  default="5"
                  type="int">Number of detection to average</input_port>
      <output_port name="average_obj"
                   type="AiDetection"/>
      <input_port name="classification"
                  type="std::string"/>
      <input_port name="camera"
                  default="0"
                  type="int">0: Front, 1: Bottom</input_port>
    </Action>
    <Condition ID="CheckAiInfo">
      <input_port name="max_count"
                  default="1"
                  type="int"/>
      <output_port name="ai_info"
                   type="AiDetectionArray"/>
      <input_port name="confidence"
                  default="0.800000"
                  type="float"/>
      <input_port name="camera"
                  default="0"
                  type="int">0: Front, 1: Bottom</input_port>
      <input_port name="min_count"
                  default="1"
                  type="int"/>
      <input_port name="classification"
                  type="std::string"/>
    </Condition>
    <Condition ID="CheckRotationZAlign">
      <input_port name="pixel_to_degrees"
                  default="0.067600"
                  type="float">0.0676 for the auv8, 0.082 for the auv7</input_port>
      <input_port name="error_margin"
                  default="0.050000"
                  type="float">percentage of error off the target (0-1)</input_port>
      <input_port name="target_x"
                  type="int"/>
      <inout_port name="traj"
                  type="Trajectory"/>
      <input_port name="detection_object"
                  type="AiDetection"/>
    </Condition>
    <Condition ID="CheckTranslationXYAlign">
      <inout_port name="traj"
                  type="Trajectory"/>
      <input_port name="error_margin"
                  default="0.050000"
                  type="float">percentage of error off the target (0-1)</input_port>
      <input_port name="target_y"
                  type="int"/>
      <input_port name="target_x"
                  type="int"/>
      <input_port name="distance"
                  type="float"/>
      <input_port name="detection_object"
                  type="AiDetection"/>
    </Condition>
    <Condition ID="CheckTranslationYZAlign">
      <input_port name="error_margin"
                  default="0.050000"
                  type="float">percentage of error off the target (0-1)</input_port>
      <input_port name="target_y"
                  type="int"/>
      <input_port name="target_x"
                  type="int"/>
      <inout_port name="traj"
                  type="Trajectory"/>
      <input_port name="detection_object"
                  type="AiDetection"/>
    </Condition>
    <Action ID="GetAngle">
      <input_port name="error_margin"
                  default="0.100000"
                  type="float"/>
      <input_port name="ideal_ratio"
                  type="float"/>
      <output_port name="detected_angle"
                   type="float"/>
      <input_port name="aiObj"
                  type="AiDetection"/>
    </Action>
    <Action ID="InitTraj">
      <output_port name="trajectory"
                   type="Trajectory"/>
    </Action>
    <SubTree ID="MoveSinglePose"
             editable="true">
      <input_port name="positionX"
                  default="0.0"/>
      <input_port name="positionY"
                  default="0.0"/>
      <input_port name="positionZ"
                  default="0.0"/>
      <input_port name="orientationX"
                  default="0.0"/>
      <input_port name="orientationY"
                  default="0.0"/>
      <input_port name="orientationZ"
                  default="0.0"/>
      <input_port name="frame"
                  default="1"/>
    </SubTree>
    <Action ID="MoveToTarget">
      <inout_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="offset"
                  type="float"/>
      <input_port name="aiObj"
                  type="AiDetection"/>
    </Action>
    <SubTree ID="RotAlignZ"
             editable="true">
      <input_port name="detection_object"/>
      <input_port name="target_x"
                  default="300"/>
      <input_port name="error_margin"
                  default="0.05"/>
      <input_port name="pixel_to_degrees"
                  default="0.0676"/>
    </SubTree>
    <Action ID="SendTrajToPlanner">
      <inout_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="interpolation"
                  default="0"
                  type="int"/>
    </Action>
    <Action ID="WaitTargetReached">
      <input_port name="timeout"
                  default="5"
                  type="int"/>
    </Action>
  </TreeNodesModel>

</root>
