<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="Bin24">
    <Sequence>
      <SubTree ID="FindBins"
               _autoremap="false"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.5"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="4"
               _autoremap="true"/>
      <Repeat num_cycles="5">
        <SubTree ID="BinAlignTrans"
                 classification="bin"
                 _autoremap="true"/>
      </Repeat>
      <Repeat num_cycles="2">
        <SubTree ID="BinAlignTrans"
                 classification="bin_rouge"
                 _autoremap="true"/>
      </Repeat>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="1.5"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="4"
               _autoremap="true"/>
      <SubTree ID="MoveSinglePose"
               positionX="-0.05"
               positionY="-0.12"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1"
               _autoremap="true"/>
      <Repeat num_cycles="2">
        <Delay delay_msec="5000">
          <ActuatorsAction side="starboard"
                           actuator="0"/>
        </Delay>
      </Repeat>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="BinAlignTrans">
    <Sequence>
      <RetryUntilSuccessful num_attempts="5">
        <CheckAiInfo max_count="1"
                     ai_info="{aiObj}"
                     confidence="0.500000"
                     camera="1"
                     min_count="1"
                     classification="{classification}"/>
      </RetryUntilSuccessful>
      <ExtractAiListItem aiObject="{bin_item}"
                         Index="0"
                         array="{aiObj}"/>
      <SubTree ID="TransAlignXY"
               detection_object="{bin_item}"
               target_x="300"
               target_y="200"
               error_margin="0.1"
               dist="1.5"
               _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="FindBins">
    <Sequence>
      <SubTree ID="RotatingSearch"
               classification="bin"
               ai_info="{bin_obj_arr}"
               confidence="0.5"
               _autoremap="true"/>
      <Repeat num_cycles="2">
        <Sequence>
          <CheckAiInfo max_count="1"
                       ai_info="{bin_obj_arr}"
                       confidence="0.600000"
                       camera="0"
                       min_count="1"
                       classification="bin"/>
          <ExtractAiListItem aiObject="{bin_obj}"
                             Index="0"
                             array="{bin_obj_arr}"/>
          <SubTree ID="RotAlignZ"
                   detection_object="{bin_obj}"
                   target_x="300"
                   error_margin="0.1"
                   _autoremap="true"/>
        </Sequence>
      </Repeat>
      <SubTree ID="StepApproachUntilLoss"
               classification="bin"
               confidence="0.6"
               _autoremap="true"/>
      <SubTree ID="StepApproachUntilSuccess"
               classification="bin"
               confidence="0.6"
               _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="ActuatorsAction">
      <input_port name="side"
                  type="std::string">port_side or starboard</input_port>
      <input_port name="actuator"
                  type="int">0: Dropper, 1: Torpedo</input_port>
    </Action>
    <SubTree ID="BinAlignTrans"
             editable="true">
      <input_port name="classification"/>
    </SubTree>
    <Condition ID="CheckAiInfo">
      <input_port name="max_count"
                  default="1"
                  type="int"/>
      <output_port name="ai_info"
                   type="AiDetectionArray"/>
      <input_port name="confidence"
                  default="0.800000"
                  type="float"/>
      <input_port name="camera"
                  default="0"
                  type="int">0: Front, 1: Bottom</input_port>
      <input_port name="min_count"
                  default="1"
                  type="int"/>
      <input_port name="classification"
                  type="std::string"/>
    </Condition>
    <Action ID="ExtractAiListItem">
      <output_port name="aiObject"
                   type="AiDetection"/>
      <input_port name="Index"
                  type="int"/>
      <input_port name="array"
                  type="AiDetectionArray"/>
    </Action>
    <SubTree ID="MoveSinglePose"
             editable="true">
      <input_port name="positionX"
                  default="0.0"/>
      <input_port name="positionY"
                  default="0.0"/>
      <input_port name="positionZ"
                  default="0.0"/>
      <input_port name="orientationX"
                  default="0.0"/>
      <input_port name="orientationY"
                  default="0.0"/>
      <input_port name="orientationZ"
                  default="0.0"/>
      <input_port name="frame"
                  default="1"/>
    </SubTree>
    <SubTree ID="RotAlignZ"
             editable="true">
      <input_port name="detection_object"/>
      <input_port name="target_x"
                  default="300"/>
      <input_port name="error_margin"
                  default="0.05"/>
    </SubTree>
    <SubTree ID="RotatingSearch"
             editable="true">
      <input_port name="classification"/>
      <output_port name="ai_info"/>
      <input_port name="confidence"
                  default="0.8"/>
    </SubTree>
    <SubTree ID="StepApproachUntilLoss"
             editable="true">
      <input_port name="classification"/>
      <input_port name="confidence"/>
    </SubTree>
    <SubTree ID="StepApproachUntilSuccess"
             editable="true">
      <input_port name="classification"/>
      <input_port name="confidence"
                  default="0.8"/>
    </SubTree>
    <SubTree ID="TransAlignXY"
             editable="true">
      <input_port name="detection_object"/>
      <input_port name="target_x"
                  default="300"/>
      <input_port name="target_y"
                  default="200"/>
      <input_port name="error_margin"
                  default="0.05"/>
      <input_port name="dist"/>
    </SubTree>
  </TreeNodesModel>

</root>
