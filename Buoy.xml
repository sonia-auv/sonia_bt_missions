<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="AlignBuoy">
    <Sequence>
      <AverageAiDetection num_retries="5"
                          buffer_size="5"
                          average_obj="{buoyObj}"
                          classification="buoy"
                          camera="0"/>
      <SubTree ID="RotAlignZ"
               detection_object="{buoyObj}"
               target_x="300"
               error_margin="0.1"
               pixel_to_degrees="0.0676"
               _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="BuoyCircle">
    <Sequence>
      <InitTraj trajectory="{traj}"/>
      <AddPoseToTraj trajectory="{traj}"
                     precision="0"
                     speed="0"
                     frame="1"
                     orientationZ="15"
                     longRotation="false"
                     positionZ="0.000000"
                     positionY="0"
                     orientationY="0.000000"
                     orientationX="0.000000"
                     positionX="0.000000"/>
      <Repeat num_cycles="12">
        <AddPoseToTraj trajectory="{traj}"
                       precision="0"
                       speed="0"
                       frame="1"
                       orientationZ="30"
                       longRotation="false"
                       positionZ="0.000000"
                       positionY="-0.75"
                       orientationY="0.000000"
                       orientationX="0.000000"
                       positionX="0.000000"/>
      </Repeat>
      <AddPoseToTraj trajectory="{traj}"
                     precision="0"
                     speed="0"
                     frame="1"
                     orientationZ="-15"
                     longRotation="false"
                     positionZ="0.000000"
                     positionY="0"
                     orientationY="0.000000"
                     orientationX="0.000000"
                     positionX="0.000000"/>
      <SendTrajToPlanner trajectory="{traj}"
                         interpolation="0"/>
      <WaitTargetReached timeout="5"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AddPoseToTraj">
      <inout_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="precision"
                  default="0"
                  type="int"/>
      <input_port name="speed"
                  default="0"
                  type="int"/>
      <input_port name="frame"
                  default="1"
                  type="int"/>
      <input_port name="orientationZ"
                  default="0.000000"
                  type="float"/>
      <input_port name="longRotation"
                  default="false"
                  type="bool"/>
      <input_port name="positionZ"
                  default="0.000000"
                  type="float"/>
      <input_port name="positionY"
                  default="0.000000"
                  type="float"/>
      <input_port name="orientationY"
                  default="0.000000"
                  type="float"/>
      <input_port name="orientationX"
                  default="0.000000"
                  type="float"/>
      <input_port name="positionX"
                  default="0.000000"
                  type="float"/>
    </Action>
    <Action ID="AverageAiDetection">
      <input_port name="num_retries"
                  default="5"
                  type="int">Number of invalid detection allowed between good ones</input_port>
      <input_port name="buffer_size"
                  default="5"
                  type="int">Number of detection to average</input_port>
      <output_port name="average_obj"
                   type="AiDetection"/>
      <input_port name="classification"
                  type="std::string"/>
      <input_port name="camera"
                  default="0"
                  type="int">0: Front, 1: Bottom</input_port>
    </Action>
    <Action ID="InitTraj">
      <output_port name="trajectory"
                   type="Trajectory"/>
    </Action>
    <SubTree ID="RotAlignZ"
             editable="true">
      <input_port name="detection_object"/>
      <input_port name="target_x"
                  default="300"/>
      <input_port name="error_margin"
                  default="0.05"/>
      <input_port name="pixel_to_degrees"
                  default="0.0676"/>
    </SubTree>
    <Action ID="SendTrajToPlanner">
      <inout_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="interpolation"
                  default="0"
                  type="int"/>
    </Action>
    <Action ID="WaitTargetReached">
      <input_port name="timeout"
                  default="5"
                  type="int"/>
    </Action>
  </TreeNodesModel>

</root>
