<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="AlignOctTrans">
    <Sequence>
      <AverageAiDetection num_retries="5"
                          buffer_size="5"
                          average_obj="{oct_obj}"
                          classification="samples_table"
                          camera="0"/>
      <SubTree ID="TransAlignXY"
               detection_object="{oct_obj}"
               target_x="300"
               target_y="200"
               error_margin="0.1"
               dist="0.9"
               _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="FindOctogone">
    <Sequence>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="1"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="4"
               _autoremap="true"/>
      <SubTree ID="RotatingSearch"
               classification="samples_table"
               ai_info="{oct_obj_array}"
               confidence="0.75"
               _autoremap="true"/>
      <Repeat num_cycles="2">
        <Sequence>
          <AverageAiDetection num_retries="5"
                              buffer_size="5"
                              average_obj="{oct_obj}"
                              classification="samples_table"
                              camera="0"/>
          <SubTree ID="RotAlignZ"
                   detection_object="{oct_obj}"
                   target_x="300"
                   error_margin="0.1"
                   pixel_to_degrees="0.0676"
                   _autoremap="true"/>
        </Sequence>
      </Repeat>
      <SubTree ID="StepApproachUntilLoss"
               classification="samples_table"
               confidence="0.6"
               _autoremap="true"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.4"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="4"
               _autoremap="true"/>
      <SubTree ID="StepApproachUntilSuccess"
               classification="samples_table"
               confidence="0.6"
               _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Octogone24">
    <Sequence>
      <SubTree ID="FindOctogone"/>
      <Repeat num_cycles="3">
        <SubTree ID="AlignOctTrans"/>
      </Repeat>
      <Fallback>
        <ControlSetMode set_mode="false"/>
        <SubTree ID="MoveSinglePose"
                 positionX="0.0"
                 positionY="0.0"
                 positionZ="-0.2"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="0.0"
                 frame="4"
                 _autoremap="true"/>
        <SubTree ID="MoveSinglePose"
                 positionX="0.0"
                 positionY="0.0"
                 positionZ="0.3"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="0.0"
                 frame="4"
                 _autoremap="true"/>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AverageAiDetection">
      <input_port name="num_retries"
                  default="5"
                  type="int">Number of invalid detection allowed between good ones</input_port>
      <input_port name="buffer_size"
                  default="5"
                  type="int">Number of detection to average</input_port>
      <output_port name="average_obj"
                   type="AiDetection"/>
      <input_port name="classification"
                  type="std::string"/>
      <input_port name="camera"
                  default="0"
                  type="int">0: Front, 1: Bottom</input_port>
    </Action>
    <Action ID="ControlSetMode">
      <input_port name="set_mode"
                  default="false"
                  type="bool"/>
    </Action>
    <SubTree ID="MoveSinglePose"
             editable="true">
      <input_port name="positionX"
                  default="0.0"/>
      <input_port name="positionY"
                  default="0.0"/>
      <input_port name="positionZ"
                  default="0.0"/>
      <input_port name="orientationX"
                  default="0.0"/>
      <input_port name="orientationY"
                  default="0.0"/>
      <input_port name="orientationZ"
                  default="0.0"/>
      <input_port name="frame"
                  default="1"/>
    </SubTree>
    <SubTree ID="RotAlignZ"
             editable="true">
      <input_port name="detection_object"/>
      <input_port name="target_x"
                  default="300"/>
      <input_port name="error_margin"
                  default="0.05"/>
      <input_port name="pixel_to_degrees"
                  default="0.0676"/>
    </SubTree>
    <SubTree ID="RotatingSearch"
             editable="true">
      <input_port name="classification"/>
      <output_port name="ai_info"/>
      <input_port name="confidence"
                  default="0.8"/>
    </SubTree>
    <SubTree ID="StepApproachUntilLoss"
             editable="true">
      <input_port name="classification"/>
      <input_port name="confidence"/>
    </SubTree>
    <SubTree ID="StepApproachUntilSuccess"
             editable="true">
      <input_port name="classification"/>
      <input_port name="confidence"
                  default="0.8"/>
    </SubTree>
    <SubTree ID="TransAlignXY"
             editable="true">
      <input_port name="detection_object"/>
      <input_port name="target_x"
                  default="300"/>
      <input_port name="target_y"
                  default="200"/>
      <input_port name="error_margin"
                  default="0.05"/>
      <input_port name="dist"/>
    </SubTree>
  </TreeNodesModel>

</root>
