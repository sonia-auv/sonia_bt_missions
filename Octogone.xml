<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="AlignOctTrans">
    <Sequence>
      <RetryUntilSuccessful num_attempts="5">
        <CheckAiInfo max_count="1"
                     ai_info="{oct_obj_array}"
                     confidence="0.75"
                     camera="1"
                     min_count="1"
                     classification="samples_table"/>
      </RetryUntilSuccessful>
      <ExtractAiListItem aiObject="{oct_obj}"
                         Index="0"
                         array="{oct_obj_array}"/>
      <SubTree ID="TransAlignXY"
               detection_object="{oct_obj}"
               target_x="300"
               target_y="200"
               error_margin="0.1"
               dist="0.9"
               _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="FindOctogone">
    <Sequence>
      <SubTree ID="RotatingSearch"
               classification="samples_table"
               ai_info="{oct_obj_array}"
               confidence="0.75"
               _autoremap="true"/>
      <Repeat num_cycles="2">
        <Sequence>
          <CheckAiInfo max_count="1"
                       ai_info="{oct_obj_array}"
                       confidence="0.75"
                       camera="0"
                       min_count="1"
                       classification="samples_table"/>
          <ExtractAiListItem aiObject="{oct_obj}"
                             Index="0"
                             array="{oct_obj_array}"/>
          <SubTree ID="RotAlignZ"
                   detection_object="{oct_obj}"
                   target_x="300"
                   error_margin="0.1"
                   pixel_to_degrees="0.0676"
                   _autoremap="true"/>
        </Sequence>
      </Repeat>
      <SubTree ID="StepApproachUntilLoss"
               classification="samples_table"
               confidence="0.75"
               _autoremap="true"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.4"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="4"
               _autoremap="true"/>
      <SubTree ID="StepApproachUntilSuccess"
               classification="samples_table"
               confidence="0.75"
               _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Octogone24">
    <Sequence>
      <SubTree ID="FindOctogone"/>
      <Repeat num_cycles="3">
        <SubTree ID="AlignOctTrans"/>
      </Repeat>
      <Fallback>
        <ControlSetMode set_mode="false"/>
        <SubTree ID="MoveSinglePose"
                 positionX="0.0"
                 positionY="0.0"
                 positionZ="-0.2"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="0.0"
                 frame="4"/>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Condition ID="CheckAiInfo">
      <input_port name="max_count"
                  default="1"
                  type="int"/>
      <output_port name="ai_info"
                   type="AiDetectionArray"/>
      <input_port name="confidence"
                  default="0.800000"
                  type="float"/>
      <input_port name="camera"
                  default="0"
                  type="int">0: Front, 1: Bottom</input_port>
      <input_port name="min_count"
                  default="1"
                  type="int"/>
      <input_port name="classification"
                  type="std::string"/>
    </Condition>
    <Action ID="ControlSetMode">
      <input_port name="set_mode"
                  default="false"
                  type="bool"/>
    </Action>
    <Action ID="ExtractAiListItem">
      <output_port name="aiObject"
                   type="AiDetection"/>
      <input_port name="Index"
                  type="int"/>
      <input_port name="array"
                  type="AiDetectionArray"/>
    </Action>
    <SubTree ID="MoveSinglePose"
             editable="true">
      <input_port name="positionX"
                  default="0.0"/>
      <input_port name="positionY"
                  default="0.0"/>
      <input_port name="positionZ"
                  default="0.0"/>
      <input_port name="orientationX"
                  default="0.0"/>
      <input_port name="orientationY"
                  default="0.0"/>
      <input_port name="orientationZ"
                  default="0.0"/>
      <input_port name="frame"
                  default="1"/>
    </SubTree>
    <SubTree ID="RotAlignZ"
             editable="true">
      <input_port name="detection_object"/>
      <input_port name="target_x"
                  default="300"/>
      <input_port name="error_margin"
                  default="0.05"/>
      <input_port name="pixel_to_degrees"
                  default="0.0676"/>
    </SubTree>
    <SubTree ID="RotatingSearch"
             editable="true">
      <input_port name="classification"/>
      <output_port name="ai_info"/>
      <input_port name="confidence"
                  default="0.8"/>
    </SubTree>
    <SubTree ID="StepApproachUntilLoss"
             editable="true">
      <input_port name="classification"/>
      <input_port name="confidence"/>
    </SubTree>
    <SubTree ID="StepApproachUntilSuccess"
             editable="true">
      <input_port name="classification"/>
      <input_port name="confidence"
                  default="0.8"/>
    </SubTree>
    <SubTree ID="TransAlignXY"
             editable="true">
      <input_port name="detection_object"/>
      <input_port name="target_x"
                  default="300"/>
      <input_port name="target_y"
                  default="200"/>
      <input_port name="error_margin"
                  default="0.05"/>
      <input_port name="dist"/>
    </SubTree>
  </TreeNodesModel>

</root>
