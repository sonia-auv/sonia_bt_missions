<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="AUV7_24">
    <Fallback>
      <Sequence>
        <SubTree ID="enable_mission"/>
        <SubTree ID="CoinFlip"/>
        <SubTree ID="Gate24"/>
        <IfThenElse>
          <SubTree ID="Bin24"/>
          <SubTree ID="Octogone24"/>
          <Sequence>
            <SubTree ID="MoveSinglePose"
                     positionX="0.0"
                     positionY="0.0"
                     positionZ="0.0"
                     orientationX="0.0"
                     orientationY="0.0"
                     orientationZ="0.0"
                     frame="2"
                     _autoremap="true"/>
            <SubTree ID="Octogone24"/>
          </Sequence>
        </IfThenElse>
      </Sequence>
      <SubTree ID="EndCase"/>
    </Fallback>
  </BehaviorTree>

  <BehaviorTree ID="AUV8_24">
    <IfThenElse>
      <Sequence>
        <SubTree ID="enable_mission"/>
        <SubTree ID="CoinFlip"/>
        <SubTree ID="Gate24"
                 _autoremap="false"/>
        <SubTree ID="MoveSinglePose"
                 positionX="0"
                 positionY="0.0"
                 positionZ="0.8"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="0.0"
                 frame="4"
                 _autoremap="true"/>
        <SubTree ID="TrickShotSingle"/>
        <SubTree ID="Buoy24"/>
        <SubTree ID="Torpedoes24"
                 _autoremap="false"/>
      </Sequence>
      <SubTree ID="Backflip"/>
      <SubTree ID="EndCase"/>
    </IfThenElse>
  </BehaviorTree>

  <BehaviorTree ID="Backflip">
    <Sequence>
      <InitTraj trajectory="{back_traj}"/>
      <AddPoseToTraj trajectory="{back_traj}"
                     precision="0"
                     speed="0"
                     frame="1"
                     orientationZ="0.000000"
                     longRotation="false"
                     positionZ="0.000000"
                     positionY="0.000000"
                     orientationY="180"
                     orientationX="0.000000"
                     positionX="0.000000"/>
      <AddPoseToTraj trajectory="{back_traj}"
                     precision="0"
                     speed="0"
                     frame="1"
                     orientationZ="0.000000"
                     longRotation="false"
                     positionZ="0.000000"
                     positionY="0.000000"
                     orientationY="180"
                     orientationX="0.000000"
                     positionX="0.000000"/>
      <SendTrajToPlanner trajectory="{back_traj}"
                         interpolation="0"/>
      <WaitTargetReached timeout="5"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Buoy24">
    <Sequence>
      <SubTree ID="RotatingSearch"
               classification="buoy"
               ai_info="{buoy}"
               confidence="0.6"
               _autoremap="true"/>
      <Repeat num_cycles="2">
        <SubTree ID="AlignBuoy"/>
      </Repeat>
      <SubTree ID="ApprocheTarget"
               classification="buoy"
               offset="-0.75"
               confidence="0.6"
               _autoremap="true"/>
      <SubTree ID="BuoyCircle"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="EndCase">
    <Sequence>
      <InitTraj trajectory="{end_traj}"/>
      <AddPoseToTraj trajectory="{end_traj}"
                     precision="0"
                     speed="0"
                     frame="1"
                     orientationZ="180"
                     longRotation="false"
                     positionZ="0.000000"
                     positionY="0.000000"
                     orientationY="0.000000"
                     orientationX="0.000000"
                     positionX="0.000000"/>
      <AddPoseToTraj trajectory="{end_traj}"
                     precision="0"
                     speed="0"
                     frame="1"
                     orientationZ="180"
                     longRotation="false"
                     positionZ="0.000000"
                     positionY="0.000000"
                     orientationY="0.000000"
                     orientationX="0.000000"
                     positionX="0.000000"/>
      <SendTrajToPlanner trajectory="{end_traj}"
                         interpolation="0"/>
      <WaitTargetReached timeout="5"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Gate24">
    <Sequence>
      <Repeat num_cycles="2">
        <SubTree ID="GateAlignTrans"/>
      </Repeat>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.5"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="4"
               _autoremap="true"/>
      <SubTree ID="ApprocheTarget"
               classification="gate_rouge"
               offset="2"
               confidence="0.6"
               _autoremap="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Run24">
    <Sequence>
      <SubTree ID="enable_mission"/>
      <SubTree ID="CoinFlip"/>
      <SubTree ID="Gate24"
               _autoremap="false"/>
      <SubTree ID="MoveSinglePose"
               positionX="0"
               positionY="0.0"
               positionZ="0.8"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="4"
               _autoremap="true"/>
      <SubTree ID="TrickShotSingle"/>
      <SubTree ID="Buoy24"/>
      <SubTree ID="Bin24"/>
      <SubTree ID="Torpedoes24"
               _autoremap="false"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Torpedoes24">
    <Sequence>
      <SubTree ID="FindTorp"/>
      <SubTree ID="AlignTorpFrame"
               _autoremap="false"/>
      <SubTree ID="AlignTorpFrameAngle"/>
      <SubTree ID="AlignTorpFrame"/>
      <SubTree ID="ApprocheTarget"
               classification="torpille"
               offset="-1.5"
               confidence="0.6"/>
      <SubTree ID="AlignTorpID"
               sizeID="0"
               _autoremap="true"/>
      <SubTree ID="AlignStar"/>
      <Repeat num_cycles="3">
        <ActuatorsAction side="starboard"
                         actuator="1"/>
      </Repeat>
      <SubTree ID="MoveSinglePose"
               positionX="-1.5"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1"
               _autoremap="true"/>
      <SubTree ID="AlignTorpID"
               sizeID="1"
               _autoremap="true"/>
      <SubTree ID="AlignPort"/>
      <Repeat num_cycles="3">
        <ActuatorsAction side="port_side"
                         actuator="1"/>
      </Repeat>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="ActuatorsAction">
      <input_port name="side"
                  type="std::string">port_side or starboard</input_port>
      <input_port name="actuator"
                  type="int">0: Dropper, 1: Torpedo</input_port>
    </Action>
    <Action ID="AddPoseToTraj">
      <inout_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="precision"
                  default="0"
                  type="int"/>
      <input_port name="speed"
                  default="0"
                  type="int"/>
      <input_port name="frame"
                  default="1"
                  type="int"/>
      <input_port name="orientationZ"
                  default="0.000000"
                  type="float"/>
      <input_port name="longRotation"
                  default="false"
                  type="bool"/>
      <input_port name="positionZ"
                  default="0.000000"
                  type="float"/>
      <input_port name="positionY"
                  default="0.000000"
                  type="float"/>
      <input_port name="orientationY"
                  default="0.000000"
                  type="float"/>
      <input_port name="orientationX"
                  default="0.000000"
                  type="float"/>
      <input_port name="positionX"
                  default="0.000000"
                  type="float"/>
    </Action>
    <SubTree ID="AlignTorpID"
             editable="true">
      <input_port name="sizeID"
                  default="0"/>
    </SubTree>
    <SubTree ID="ApprocheTarget"
             editable="true">
      <input_port name="classification"/>
      <input_port name="offset"
                  default="0"/>
      <input_port name="confidence"
                  default="0.8"/>
    </SubTree>
    <Action ID="InitTraj">
      <output_port name="trajectory"
                   type="Trajectory"/>
    </Action>
    <SubTree ID="MoveSinglePose"
             editable="true">
      <input_port name="positionX"
                  default="0.0"/>
      <input_port name="positionY"
                  default="0.0"/>
      <input_port name="positionZ"
                  default="0.0"/>
      <input_port name="orientationX"
                  default="0.0"/>
      <input_port name="orientationY"
                  default="0.0"/>
      <input_port name="orientationZ"
                  default="0.0"/>
      <input_port name="frame"
                  default="1"/>
    </SubTree>
    <SubTree ID="RotatingSearch"
             editable="true">
      <input_port name="classification"/>
      <output_port name="ai_info"/>
      <input_port name="confidence"
                  default="0.8"/>
    </SubTree>
    <Action ID="SendTrajToPlanner">
      <inout_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="interpolation"
                  default="0"
                  type="int"/>
    </Action>
    <Action ID="WaitTargetReached">
      <input_port name="timeout"
                  default="5"
                  type="int"/>
    </Action>
  </TreeNodesModel>

</root>
