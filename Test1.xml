<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="root">
  <BehaviorTree ID="root">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="test1">
    <Sequence>
      <Torpedos side="port_side"/>
      <Droppers side="starboard"/>
      <Torpedos side="starboard"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="Droppers">
      <input_port name="side"
                  type="std::string">port_side or starboard</input_port>
    </Action>
    <Condition ID="MissionSwitchStatus"/>
    <Action ID="Torpedos">
      <input_port name="side"
                  type="std::string">port_side or starboard</input_port>
    </Action>
  </TreeNodesModel>

</root>
