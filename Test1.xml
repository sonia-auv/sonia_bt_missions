<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="root">
  <BehaviorTree ID="Denise1.0">
    <Sequence>
      <SubTree ID="boot_sequence"/>
      <SubTree ID="MoveSinglePose"
               positionX="2"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="0.0"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="MoveSinglePose">
    <Sequence>
      <InitializeTrajectory trajectory="{traj}"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="0"
                            frame="{frame}"
                            orientationZ="{orientationZ}"
                            longRotation="false"
                            positionZ="{positionZ}"
                            positionY="{positionY}"
                            orientationY="{orientationY}"
                            orientationX="{orientationX}"
                            positionX="{positionX}"/>
      <SendTrajectory trajectory="{traj}"
                      interpolation="0"/>
      <WaitTargetReached timeout="5"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="boot_sequence">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <Tare sensor="imu"/>
      <EnableDisableDVL dvl_input="true"/>
      <ControlSetMode set_mode="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="root">
    <Sequence>
      <SubTree ID="boot_sequence"/>
      <Delay delay_msec="5000">
        <SubTree ID="MoveSinglePose"
                 positionX="0.0"
                 positionY="0.0"
                 positionZ="0.3"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="0.0"
                 frame="1.0"/>
      </Delay>
      <Delay delay_msec="3000">
        <SubTree ID="MoveSinglePose"
                 positionX="0.0"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="90"
                 frame="1.0"/>
      </Delay>
      <Delay delay_msec="3000">
        <SubTree ID="MoveSinglePose"
                 positionX="0.0"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="-90"
                 frame="1.0"/>
      </Delay>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="test1">
    <Sequence>
      <Torpedos side="port_side"/>
      <Droppers side="starboard"/>
      <Torpedos side="starboard"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="ControlSetMode">
      <input_port name="set_mode"
                  default="false"
                  type="bool"/>
    </Action>
    <Action ID="Droppers">
      <input_port name="side"
                  type="std::string">port_side or starboard</input_port>
    </Action>
    <Action ID="EnableDisableDVL">
      <input_port name="dvl_input"
                  default="false"
                  type="bool">true: start, false: stop</input_port>
    </Action>
    <Action ID="InitializeTrajectory">
      <output_port name="trajectory"
                   type="Trajectory"/>
    </Action>
    <Condition ID="MissionSwitchStatus"/>
    <SubTree ID="MoveSinglePose"
             editable="true">
      <input_port name="positionX"
                  default="0.0"/>
      <input_port name="positionY"
                  default="0.0"/>
      <input_port name="positionZ"
                  default="0.0"/>
      <input_port name="orientationX"
                  default="0.0"/>
      <input_port name="orientationY"
                  default="0.0"/>
      <input_port name="orientationZ"
                  default="0.0"/>
      <input_port name="frame"
                  default="0.0"/>
    </SubTree>
    <Action ID="SendTrajectory">
      <input_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="interpolation"
                  default="0"
                  type="int"/>
    </Action>
    <Action ID="Tare">
      <input_port name="sensor"
                  type="std::string">imu or depth</input_port>
    </Action>
    <Action ID="Torpedos">
      <input_port name="side"
                  type="std::string">port_side or starboard</input_port>
    </Action>
    <Action ID="TrajectoryAppendPose">
      <inout_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="precision"
                  default="0"
                  type="int"/>
      <input_port name="speed"
                  default="0"
                  type="int"/>
      <input_port name="frame"
                  default="1"
                  type="int"/>
      <input_port name="orientationZ"
                  default="0.000000"
                  type="float"/>
      <input_port name="longRotation"
                  default="false"
                  type="bool"/>
      <input_port name="positionZ"
                  default="0.000000"
                  type="float"/>
      <input_port name="positionY"
                  default="0.000000"
                  type="float"/>
      <input_port name="orientationY"
                  default="0.000000"
                  type="float"/>
      <input_port name="orientationX"
                  default="0.000000"
                  type="float"/>
      <input_port name="positionX"
                  default="0.000000"
                  type="float"/>
    </Action>
    <Action ID="WaitTargetReached">
      <input_port name="timeout"
                  default="5"
                  type="int"/>
    </Action>
  </TreeNodesModel>

</root>
