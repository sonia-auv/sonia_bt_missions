<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="MovingSquareSequence">
    <Sequence>
      <SubTree ID="MoveSinglePose"
               frame="2.0"
               positionX="0.0"
               positionY="0.0"
               positionZ="1.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"/>
      <Repeat num_cycles="4">
        <Sequence>
          <SubTree ID="MoveSinglePose"
                   frame="2.0"
                   positionX="2.0"
                   positionY="0.0"
                   positionZ="0.0"
                   orientationX="0.0"
                   orientationY="0.0"
                   orientationZ="0.0"/>
          <SubTree ID="MoveSinglePose"
                   frame="2.0"
                   positionX="0.0"
                   positionY="0.0"
                   positionZ="0.0"
                   orientationX="0.0"
                   orientationY="0.0"
                   orientationZ="90.0"/>
        </Sequence>
      </Repeat>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="PrequalificationRun">
    <AlwaysSuccess/>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <SubTree ID="MoveSinglePose"
             editable="true">
      <input_port name="frame"
                  default="1.0">Submarine reference type</input_port>
      <input_port name="positionX"
                  default="0.0">x value to go</input_port>
      <input_port name="positionY"
                  default="0.0">y value to go</input_port>
      <input_port name="positionZ"
                  default="0.0">z value to go</input_port>
      <input_port name="orientationX"
                  default="0.0">z orientation to go</input_port>
      <input_port name="orientationY"
                  default="0.0">y orientation to go</input_port>
      <input_port name="orientationZ"
                  default="0.0">x orientation to go</input_port>
    </SubTree>
  </TreeNodesModel>

</root>
