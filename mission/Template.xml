<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="BootingSequence">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <Tare sensor="imu"/>
      <EnableDisableDVL dvl_input="true"/>
      <ControlSetMode set_mode="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="MissionFailed">
    <Sequence>
      <InitializeTrajectory trajectory="{traj}"/>
      <Repeat num_cycles="2">
        <TrajectoryAppendPose trajectory="{traj}"
                              precision="0"
                              speed="2"
                              frame="1"
                              orientationZ="180"
                              longRotation="false"
                              positionZ="0.000000"
                              positionY="0.000000"
                              orientationY="0.000000"
                              orientationX="0.000000"
                              positionX="0.000000"/>
      </Repeat>
      <SendTrajectory trajectory="{traj}"
                      interpolation="0"/>
      <AlwaysFailure/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="MissionSuccess">
    <Sequence>
      <InitializeTrajectory trajectory="{traj}"/>
      <Repeat num_cycles="2">
        <TrajectoryAppendPose trajectory="{traj}"
                              precision="0"
                              speed="0"
                              frame="1"
                              orientationZ="180"
                              longRotation="false"
                              positionZ="0.000000"
                              positionY="0.000000"
                              orientationY="0.000000"
                              orientationX="0.000000"
                              positionX="0.000000"/>
      </Repeat>
      <SendTrajectory trajectory="{traj}"
                      interpolation="0"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="MoveSinglePose">
    <Sequence>
      <InitializeTrajectory trajectory="{traj}"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="{frame}"
                            orientationZ="{orientationZ}"
                            longRotation="false"
                            positionZ="{positionZ}"
                            positionY="{positionY}"
                            orientationY="{orientationY}"
                            orientationX="{orientationX}"
                            positionX="{positionX}"/>
      <SendTrajectory trajectory="{traj}"
                      interpolation="0"/>
      <WaitTargetReached timeout="5"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="RotateToAbsoluteAngle">
    <SubTree ID="MoveSinglePose"
             frame="2.0"
             positionX="0.0"
             positionY="0.0"
             positionZ="0.0"
             orientationX="0.0"
             orientationY="0.0"
             orientationZ="{Angle}"/>
  </BehaviorTree>

  <BehaviorTree ID="SearchObjectByRotation">
    <Sequence>
      <SubTree ID="RotateToAbsoluteAngle"
               Angle="{StartingAngle}"/>
      <Fallback>
        <AiFilter Detected_object_array="{FoundAiDetection}"
                  Max_frame_before_failling="5"
                  Max_frame_depth="25"
                  Min_size_output="1"
                  Confidence="0.600000"
                  Max_size_output="1"
                  Object_class="{Object}"
                  Camera="1"/>
        <Sequence>
          <SubTree ID="MoveSinglePose"
                   frame="1.0"
                   positionX="0.0"
                   positionY="0.0"
                   positionZ="0.0"
                   orientationX="0.0"
                   orientationY="0.0"
                   orientationZ="30"/>
          <Fallback>
            <AiFilter Detected_object_array="{FoundAiDetection}"
                      Max_frame_before_failling="5"
                      Max_frame_depth="25"
                      Min_size_output="1"
                      Confidence="0.600000"
                      Max_size_output="1"
                      Object_class="{Object}"
                      Camera="1"/>
            <Sequence>
              <SubTree ID="MoveSinglePose"
                       frame="1.0"
                       positionX="0.0"
                       positionY="0.0"
                       positionZ="0.0"
                       orientationX="0.0"
                       orientationY="0.0"
                       orientationZ="-60"/>
              <Fallback>
                <AiFilter Detected_object_array="{FoundAiDetection}"
                          Max_frame_before_failling="5"
                          Max_frame_depth="25"
                          Min_size_output="1"
                          Confidence="0.600000"
                          Max_size_output="1"
                          Object_class="{Object}"
                          Camera="1"/>
                <Sequence>
                  <SubTree ID="MoveSinglePose"
                           frame="1.0"
                           positionX="0.0"
                           positionY="0.0"
                           positionZ="0.0"
                           orientationX="0.0"
                           orientationY="0.0"
                           orientationZ="-30"/>
                  <Fallback>
                    <AiFilter Detected_object_array="{FoundAiDetection}"
                              Max_frame_before_failling="5"
                              Max_frame_depth="25"
                              Min_size_output="1"
                              Confidence="0.600000"
                              Max_size_output="1"
                              Object_class="{Object}"
                              Camera="1"/>
                    <Sequence>
                      <SubTree ID="MoveSinglePose"
                               frame="1.0"
                               positionX="0.0"
                               positionY="0.0"
                               positionZ="0.0"
                               orientationX="0.0"
                               orientationY="0.0"
                               orientationZ="120"/>
                      <IfThenElse>
                        <AiFilter Detected_object_array="{FoundAiDetection}"
                                  Max_frame_before_failling="5"
                                  Max_frame_depth="25"
                                  Min_size_output="1"
                                  Confidence="0.600000"
                                  Max_size_output="1"
                                  Object_class="{Object}"
                                  Camera="1"/>
                        <SubTree ID="MissionFailed"/>
                      </IfThenElse>
                    </Sequence>
                  </Fallback>
                </Sequence>
              </Fallback>
            </Sequence>
          </Fallback>
        </Sequence>
      </Fallback>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="SendTrajectoryOnly">
    <Sequence>
      <SendTrajectory trajectory="{Trajectory}"
                      interpolation="0"/>
      <WaitTargetReached timeout="{TimeBerforeFailling}"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AiFilter">
      <output_port name="Detected_object_array"
                   type="AiDetectionArray"/>
      <input_port name="Max_frame_before_failling"
                  type="int">maximum allowed frames</input_port>
      <input_port name="Max_frame_depth"
                  type="float">Maximum allowed depth</input_port>
      <input_port name="Min_size_output"
                  type="int">minumum number of frames with at least one detection before sending results</input_port>
      <input_port name="Confidence"
                  default="0.600000"
                  type="float">Ai confidence</input_port>
      <input_port name="Max_size_output"
                  type="int">Max size of the output array</input_port>
      <input_port name="Object_class"
                  type="std::string">Searched object</input_port>
      <input_port name="Camera"
                  default="1"
                  type="int">1: Front, 0: Bottom</input_port>
    </Action>
    <Action ID="ControlSetMode">
      <input_port name="set_mode"
                  default="false"
                  type="bool"/>
    </Action>
    <Action ID="EnableDisableDVL">
      <input_port name="dvl_input"
                  default="false"
                  type="bool">true: start, false: stop</input_port>
    </Action>
    <Action ID="InitializeTrajectory">
      <output_port name="trajectory"
                   type="Trajectory"/>
    </Action>
    <Condition ID="MissionSwitchStatus"/>
    <SubTree ID="MoveSinglePose"
             editable="true">
      <input_port name="frame"
                  default="1.0">Submarine reference type</input_port>
      <input_port name="positionX"
                  default="0.0">x value to go</input_port>
      <input_port name="positionY"
                  default="0.0">y value to go</input_port>
      <input_port name="positionZ"
                  default="0.0">z value to go</input_port>
      <input_port name="orientationX"
                  default="0.0">z orientation to go</input_port>
      <input_port name="orientationY"
                  default="0.0">y orientation to go</input_port>
      <input_port name="orientationZ"
                  default="0.0">x orientation to go</input_port>
    </SubTree>
    <SubTree ID="RotateToAbsoluteAngle"
             editable="true">
      <input_port name="Angle"
                  default="0">Angle to position the sub with the pool</input_port>
    </SubTree>
    <Action ID="SendTrajectory">
      <input_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="interpolation"
                  default="0"
                  type="int"/>
    </Action>
    <Action ID="Tare">
      <input_port name="sensor"
                  type="std::string">imu or depth</input_port>
    </Action>
    <Action ID="TrajectoryAppendPose">
      <inout_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="precision"
                  default="0"
                  type="int"/>
      <input_port name="speed"
                  default="0"
                  type="int"/>
      <input_port name="frame"
                  default="1"
                  type="int"/>
      <input_port name="orientationZ"
                  default="0.000000"
                  type="float"/>
      <input_port name="longRotation"
                  default="false"
                  type="bool"/>
      <input_port name="positionZ"
                  default="0.000000"
                  type="float"/>
      <input_port name="positionY"
                  default="0.000000"
                  type="float"/>
      <input_port name="orientationY"
                  default="0.000000"
                  type="float"/>
      <input_port name="orientationX"
                  default="0.000000"
                  type="float"/>
      <input_port name="positionX"
                  default="0.000000"
                  type="float"/>
    </Action>
    <Action ID="WaitTargetReached">
      <input_port name="timeout"
                  default="5"
                  type="int"/>
    </Action>
  </TreeNodesModel>

</root>
