<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4">
  <BehaviorTree ID="Gate">
    <Sequence>
      <AiActivation Model="0"
                    Bottom="false"
                    Front="false"/>
      <Torpedo side=""/>
    </Sequence>
  </BehaviorTree>
  <BehaviorTree ID="MoveSinglePose">
    <Sequence>
      <InitializeTrajectory trajectory="{traj}"/>
      <TrajectoryAppendPose precision="0"
                            speed="2"
                            orientationZ="{orientationZ}"
                            orientationY="{orientationY}"
                            orientationX="{orientationX}"
                            frame="{frame}"
                            positionZ="{positionZ}"
                            trajectory="{traj}"
                            longRotation="false"
                            positionY="{positionY}"
                            positionX="{positionX}"/>
      <SendTrajectory trajectory="{traj}"
                      interpolation="0"/>
      <WaitTargetReached timeout="5"/>
    </Sequence>
  </BehaviorTree>
  <BehaviorTree ID="ai_filter">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <AiActivation Bottom="false"
                    Model="0"
                    Front="true"/>
      <Repeat num_cycles="10">
        <Delay delay_msec="5000">
          <Fallback>
            <AiFilter detected_object_array="{detect_array}"
                      Max_frame="10"
                      Max_depth="200"
                      Min_detection="3"
                      Confidence="0.4"
                      Object_class="gate_sawfish"
                      Max_size_output="5"
                      Camera="1"/>
            <AiActivation Bottom="false"
                          Model="0"
                          Front="false"/>
          </Fallback>
        </Delay>
      </Repeat>
    </Sequence>
  </BehaviorTree>
  <BehaviorTree ID="BootingSequence">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <Tare sensor="imu"/>
      <EnableDisableDVL dvl_input="true"/>
      <ControlSetMode set_mode="true"/>
    </Sequence>
  </BehaviorTree>
  <BehaviorTree ID="CoinFlip">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.5"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="2.0"/>
    </Sequence>
  </BehaviorTree>
  <BehaviorTree ID="search_object">
    <Fallback>
      <AiFilter detected_object_array="{detect_array}"
                Max_frame="5"
                Max_depth="25"
                Min_detection="1"
                Confidence="0.600000"
                Object_class="torpedo-poster"
                Max_size_output="1"
                Camera="1"/>
      <Sequence>
        <SubTree ID="MoveSinglePose"
                 positionX="0.0"
                 positionY="0.0"
                 positionZ="0.0"
                 orientationX="0.0"
                 orientationY="0.0"
                 orientationZ="30"
                 frame="1.0"/>
        <Fallback>
          <AiFilter detected_object_array="{detect_array}"
                    Max_frame="5"
                    Max_depth="25"
                    Min_detection="1"
                    Confidence="0.600000"
                    Object_class="torpedo-poster"
                    Max_size_output="1"
                    Camera="1"/>
          <Sequence>
            <SubTree ID="MoveSinglePose"
                     positionX="0.0"
                     positionY="0.0"
                     positionZ="0.0"
                     orientationX="0.0"
                     orientationY="0.0"
                     orientationZ="30"
                     frame="1.0"/>
            <Fallback>
              <AiFilter detected_object_array="{detect_array}"
                        Max_frame="5"
                        Max_depth="25"
                        Min_detection="1"
                        Confidence="0.600000"
                        Object_class="torpedo-poster"
                        Max_size_output="1"
                        Camera="1"/>
              <Sequence>
                <SubTree ID="MoveSinglePose"
                         positionX="0.0"
                         positionY="0.0"
                         positionZ="0.0"
                         orientationX="0.0"
                         orientationY="0.0"
                         orientationZ="-90"
                         frame="1.0"/>
                <Fallback>
                  <AiFilter detected_object_array="{detect_array}"
                            Max_frame="5"
                            Max_depth="25"
                            Min_detection="1"
                            Confidence="0.600000"
                            Object_class="torpedo-poster"
                            Max_size_output="1"
                            Camera="1"/>
                  <Sequence>
                    <SubTree ID="MoveSinglePose"
                             positionX="0.0"
                             positionY="0.0"
                             positionZ="0.0"
                             orientationX="0.0"
                             orientationY="0.0"
                             orientationZ="-30"
                             frame="1.0"/>
                    <AiFilter detected_object_array=""
                              Max_frame="5"
                              Max_depth="25"
                              Min_detection="1"
                              Confidence="0.600000"
                              Object_class="torpedo-poster"
                              Max_size_output="1"
                              Camera="1"/>
                  </Sequence>
                </Fallback>
              </Sequence>
            </Fallback>
          </Sequence>
        </Fallback>
      </Sequence>
    </Fallback>
  </BehaviorTree>
  <BehaviorTree ID="trickshot">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.75"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="4"/>
      <InitializeTrajectory trajectory="{traj}"/>
      <TrajectoryAppendPose precision="0"
                            speed="2"
                            orientationZ="0.000000"
                            orientationY="90"
                            orientationX="0"
                            frame="1"
                            positionZ="0.000000"
                            trajectory="{traj}"
                            longRotation="false"
                            positionY="0.000000"
                            positionX="0.000000"/>
      <TrajectoryAppendPose precision="0"
                            speed="2"
                            orientationZ="0"
                            orientationY="0.000000"
                            orientationX="0180"
                            frame="1"
                            positionZ="0.000000"
                            trajectory="{traj}"
                            longRotation="false"
                            positionY="0.000000"
                            positionX="0.000000"/>
      <TrajectoryAppendPose precision="0"
                            speed="2"
                            orientationZ="180"
                            orientationY="0.000000"
                            orientationX="0.000000"
                            frame="1"
                            positionZ="0.000000"
                            trajectory="{traj}"
                            longRotation="false"
                            positionY="0.000000"
                            positionX="0.000000"/>
      <TrajectoryAppendPose precision="0"
                            speed="2"
                            orientationZ="180"
                            orientationY="0.000000"
                            orientationX="0"
                            frame="1"
                            positionZ="0.000000"
                            trajectory="{traj}"
                            longRotation="false"
                            positionY="0.000000"
                            positionX="0.000000"/>
      <TrajectoryAppendPose precision="0"
                            speed="2"
                            orientationZ="0"
                            orientationY="-180"
                            orientationX="0"
                            frame="1"
                            positionZ="0.000000"
                            trajectory="{traj}"
                            longRotation="false"
                            positionY="0.000000"
                            positionX="0.000000"/>
      <TrajectoryAppendPose precision="0"
                            speed="2"
                            orientationZ="0"
                            orientationY="-90"
                            orientationX="0"
                            frame="1"
                            positionZ="0.000000"
                            trajectory="{traj}"
                            longRotation="false"
                            positionY="0.000000"
                            positionX="0.000000"/>
      <TrajectoryAppendPose precision="0"
                            speed="2"
                            orientationZ="0"
                            orientationY="0.000000"
                            orientationX="180"
                            frame="1"
                            positionZ="0.000000"
                            trajectory="{traj}"
                            longRotation="false"
                            positionY="0.000000"
                            positionX="0.000000"/>
      <SendTrajectory trajectory="{traj}"
                      interpolation="0"/>
      <WaitTargetReached timeout="10"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AiActivation">
      <input_port name="Model"
                  default="0"
                  type="int">model choice, default = 0</input_port>
      <input_port name="Bottom"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
      <input_port name="Front"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
    </Action>
    <Action ID="Torpedo">
      <input_port name="side"
                  type="std::string">port_side or starboard</input_port>
    </Action>
  </TreeNodesModel>

</root>
