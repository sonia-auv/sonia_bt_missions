<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="root">
  <BehaviorTree ID="Denise1.0">
    <Sequence>
      <SubTree ID="boot_sequence"/>
      <SubTree ID="MoveSinglePose"
               positionX="2"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="0.0"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="root">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.5"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1"/>
      <SubTree ID="MoveSinglePose"
               positionX="5"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="90"
               frame="1"/>
      <SubTree ID="MoveSinglePose"
               positionX="5"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="90"
               frame="1"/>
      <SubTree ID="MoveSinglePose"
               positionX="5"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="90"
               frame="1"/>
      <SubTree ID="MoveSinglePose"
               positionX="5"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1"/>
      <Torpedo side="port_side"/>
      <Torpedo side="port"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="square">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.5"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="2"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="90"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="2"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="90"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="2"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="90"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="2"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="90"
               frame="1.0"/>
      <Delay delay_msec="2000">
        <Torpedo side="port_side"/>
      </Delay>
      <Delay delay_msec="2000">
        <Torpedo side="starboard"/>
      </Delay>
      <Delay delay_msec="2000">
        <ControlSetMode set_mode="false"/>
      </Delay>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="ControlSetMode">
      <input_port name="set_mode"
                  default="false"
                  type="bool"/>
    </Action>
    <Condition ID="MissionSwitchStatus"/>
    <SubTree ID="MoveSinglePose"
             editable="true">
      <input_port name="positionX"
                  default="0.0"/>
      <input_port name="positionY"
                  default="0.0"/>
      <input_port name="positionZ"
                  default="0.0"/>
      <input_port name="orientationX"
                  default="0.0"/>
      <input_port name="orientationY"
                  default="0.0"/>
      <input_port name="orientationZ"
                  default="0.0"/>
      <input_port name="frame"
                  default="1.0"/>
    </SubTree>
    <Action ID="Torpedo">
      <input_port name="side"
                  type="std::string">port_side or starboard</input_port>
    </Action>
  </TreeNodesModel>

</root>
