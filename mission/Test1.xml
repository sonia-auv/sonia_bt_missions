<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="root">
  <BehaviorTree ID="Denise1.0">
    <Sequence>
      <SubTree ID="boot_sequence"/>
      <SubTree ID="MoveSinglePose"
               positionX="2"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="0.0"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="drift">
    <Sequence>
      <Script code="Width_growing:=-1"/>
      <Script code="Previous_width:=800"/>
      <WhileDoElse>
        <CheckBoundingBox New_width="{New_width}"
                          New_width_growth="{New_width_growth}"
                          Width_growing="{Width_growing}"
                          Object="{slalom_det_arr}"
                          Previous_width="{Previous_width}"/>
        <AlwaysSuccess/>
        <Sequence>
          <AiFilter detected_object_array="{slalom_det_arr}"
                    Max_frame="15"
                    Max_depth="10"
                    Min_detection="3"
                    Confidence="0.500000"
                    Object_class="red-slalom"
                    Max_size_output="1"
                    Camera="1"/>
          <Alignment TranslationY="{lat_trans}"
                     traj="{slalom_traj}"
                     RotationZ="{RotationZ}"
                     Camera_front="false"
                     TranslationX_CamBottom="{TranslationX_CamBottom}"
                     alignement_by_translation="true"
                     detections="{slalom_det_arr}"/>
          <SendTrajectory trajectory="{slalom_traj}"
                          interpolation="0"/>
          <WaitTargetReached timeout="5"/>
          <CheckDistance TranslationX="{translationX}"
                         Object="{slalom_det_arr}"/>
          <SubTree ID="MoveSinglePose"
                   positionX="0.0"
                   positionY="0"
                   positionZ="0.0"
                   orientationX="0.0"
                   orientationY="0.0"
                   orientationZ="30"
                   frame="1.0"/>
          <CheckBoundingBox New_width="{New_width}"
                            New_width_growth="{New_width_growth}"
                            Width_growing="{Width_growing}"
                            Object="{slalom_det_arr}"
                            Previous_width="{Previous_width}"/>
          <SubTree ID="MoveSinglePose"
                   positionX="0.0"
                   positionY="-0.6"
                   positionZ="0.0"
                   orientationX="0.0"
                   orientationY="0.0"
                   orientationZ="0.0"
                   frame="1.0"/>
          <SubTree ID="MoveSinglePose"
                   positionX="0.0"
                   positionY="0"
                   positionZ="0.0"
                   orientationX="0.0"
                   orientationY="0.0"
                   orientationZ="30"
                   frame="1.0"/>
        </Sequence>
      </WhileDoElse>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="root">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.5"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1"/>
      <SubTree ID="MoveSinglePose"
               positionX="5"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="90"
               frame="1"/>
      <SubTree ID="MoveSinglePose"
               positionX="5"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="90"
               frame="1"/>
      <SubTree ID="MoveSinglePose"
               positionX="5"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="90"
               frame="1"/>
      <SubTree ID="MoveSinglePose"
               positionX="5"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1"/>
      <Torpedo side="port_side"/>
      <Torpedo side="port"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="square">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.5"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="2"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="90"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="2"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="90"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="2"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="90"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="2"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="90"
               frame="1.0"/>
      <Delay delay_msec="2000">
        <Torpedo side="port_side"/>
      </Delay>
      <Delay delay_msec="2000">
        <Torpedo side="starboard"/>
      </Delay>
      <Delay delay_msec="2000">
        <ControlSetMode set_mode="false"/>
      </Delay>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AiFilter">
      <output_port name="detected_object_array"
                   type="AiDetectionArray"/>
      <input_port name="Max_frame"
                  type="int">maximum allowed frames</input_port>
      <input_port name="Max_depth"
                  type="float">Maximum allowed depth</input_port>
      <input_port name="Min_detection"
                  type="int">minumum number of frames with at least one detection before sending results</input_port>
      <input_port name="Confidence"
                  default="0.600000"
                  type="float">Ai confidence</input_port>
      <input_port name="Object_class"
                  type="std::string">Searched object</input_port>
      <input_port name="Max_size_output"
                  type="int">Max size of the output array</input_port>
      <input_port name="Camera"
                  default="1"
                  type="int">1: Front, 0: Bottom</input_port>
    </Action>
    <Action ID="Alignment">
      <output_port name="TranslationY"
                   type="float"/>
      <inout_port name="traj"
                  type="Trajectory"/>
      <output_port name="RotationZ"
                   type="float"/>
      <input_port name="Camera_front"
                  type="bool"/>
      <output_port name="TranslationX_CamBottom"
                   type="float"/>
      <input_port name="alignement_by_translation"
                  type="bool"/>
      <input_port name="detections"
                  type="AiDetectionArray"/>
    </Action>
    <Action ID="CheckBoundingBox">
      <output_port name="New_width"
                   type="int"/>
      <input_port name="New_width_growth"
                  type="bool"/>
      <input_port name="Width_growing"
                  type="bool"/>
      <input_port name="Object"
                  type="AiDetectionArray"/>
      <input_port name="Previous_width"
                  type="int"/>
    </Action>
    <Action ID="CheckDistance">
      <output_port name="TranslationX"
                   type="float"/>
      <input_port name="Object"
                  type="AiDetectionArray"/>
    </Action>
    <Action ID="ControlSetMode">
      <input_port name="set_mode"
                  default="false"
                  type="bool"/>
    </Action>
    <Condition ID="MissionSwitchStatus"/>
    <SubTree ID="MoveSinglePose"
             editable="true">
      <input_port name="positionX"
                  default="0.0"/>
      <input_port name="positionY"
                  default="0.0"/>
      <input_port name="positionZ"
                  default="0.0"/>
      <input_port name="orientationX"
                  default="0.0"/>
      <input_port name="orientationY"
                  default="0.0"/>
      <input_port name="orientationZ"
                  default="0.0"/>
      <input_port name="frame"
                  default="1.0"/>
    </SubTree>
    <Action ID="SendTrajectory">
      <input_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="interpolation"
                  default="0"
                  type="int"/>
    </Action>
    <Action ID="Torpedo">
      <input_port name="side"
                  type="std::string">port_side or starboard</input_port>
    </Action>
    <Action ID="WaitTargetReached">
      <input_port name="timeout"
                  default="5"
                  type="int"/>
    </Action>
  </TreeNodesModel>

</root>
