<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="root">
  <BehaviorTree ID="Denise1.0">
    <Sequence>
      <SubTree ID="boot_sequence"/>
      <SubTree ID="MoveSinglePose"
               positionX="2"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="0.0"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="MoveSinglePose">
    <Sequence>
      <InitializeTrajectory trajectory="{traj}"/>
      <TrajectoryAppendPose precision="0"
                            speed="0"
                            orientationZ="{orientationZ}"
                            orientationY="{orientationY}"
                            orientationX="{orientationX}"
                            frame="{frame}"
                            positionZ="{positionZ}"
                            trajectory="{traj}"
                            longRotation="false"
                            positionY="{positionY}"
                            positionX="{positionX}"/>
      <SendTrajectory trajectory="{traj}"
                      interpolation="0"/>
      <WaitTargetReached timeout="5"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="aifilter">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <AiActivation Bottom="false"
                    Model="0"
                    Front="true"/>
      <Repeat num_cycles="10">
        <Delay delay_msec="5000">
          <AiFilter detected_object_array="{detect_array}"
                    Max_frame="10"
                    Max_depth="200"
                    Min_detection="3"
                    Confidence="0.4"
                    Object_class="gate_sawfish"
                    Max_size_output="5"
                    Camera="1"/>
        </Delay>
      </Repeat>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="boot_sequence">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <Tare sensor="imu"/>
      <EnableDisableDVL dvl_input="true"/>
      <ControlSetMode set_mode="true"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="coin_flip">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="1.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="2.0"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="root">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.5"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1"/>
      <SubTree ID="MoveSinglePose"
               positionX="5"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="90"
               frame="1"/>
      <SubTree ID="MoveSinglePose"
               positionX="5"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="90"
               frame="1"/>
      <SubTree ID="MoveSinglePose"
               positionX="5"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="90"
               frame="1"/>
      <SubTree ID="MoveSinglePose"
               positionX="5"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1"/>
      <Torpedo side="port_side"/>
      <Torpedo side="port"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="square">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.5"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="2"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="90"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="2"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="90"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="2"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="90"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="2"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="90"
               frame="1.0"/>
      <Delay delay_msec="2000">
        <Torpedo side="port_side"/>
      </Delay>
      <Delay delay_msec="2000">
        <Torpedo side="starboard"/>
      </Delay>
      <Delay delay_msec="2000">
        <ControlSetMode set_mode="false"/>
      </Delay>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="trickshot">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="1"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1"/>
      <InitializeTrajectory trajectory="{traj}"/>
      <TrajectoryAppendPose precision="0"
                            speed="0"
                            orientationZ="0.000000"
                            orientationY="90"
                            orientationX="0.000000"
                            frame="1"
                            positionZ="0.000000"
                            trajectory="{traj}"
                            longRotation="false"
                            positionY="0.000000"
                            positionX="0.000000"/>
      <TrajectoryAppendPose precision="0"
                            speed="0"
                            orientationZ="0.000000"
                            orientationY="0.000000"
                            orientationX="180"
                            frame="1"
                            positionZ="0.000000"
                            trajectory="{traj}"
                            longRotation="false"
                            positionY="0.000000"
                            positionX="0.000000"/>
      <TrajectoryAppendPose precision="0"
                            speed="0"
                            orientationZ="0.000000"
                            orientationY="0.000000"
                            orientationX="180"
                            frame="1"
                            positionZ="0.000000"
                            trajectory="{traj}"
                            longRotation="false"
                            positionY="0.000000"
                            positionX="0.000000"/>
      <TrajectoryAppendPose precision="0"
                            speed="0"
                            orientationZ="0.000000"
                            orientationY="90"
                            orientationX="0.000000"
                            frame="1"
                            positionZ="0.000000"
                            trajectory="{traj}"
                            longRotation="false"
                            positionY="0.000000"
                            positionX="0.000000"/>
      <TrajectoryAppendPose precision="0"
                            speed="0"
                            orientationZ="0.000000"
                            orientationY="180"
                            orientationX="0.000000"
                            frame="1"
                            positionZ="0.000000"
                            trajectory="{traj}"
                            longRotation="false"
                            positionY="0.000000"
                            positionX="0.000000"/>
      <SendTrajectory trajectory="{traj}"
                      interpolation="0"/>
      <WaitTargetReached timeout="10"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AiActivation">
      <input_port name="Bottom"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
      <input_port name="Model"
                  default="0"
                  type="int">model choice, default = 0</input_port>
      <input_port name="Front"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
    </Action>
    <Action ID="AiFilter">
      <output_port name="detected_object_array"
                   type="AiDetectionArray"/>
      <input_port name="Max_frame"
                  type="int">maximum allowed frames</input_port>
      <input_port name="Max_depth"
                  type="float">Maximum allowed depth</input_port>
      <input_port name="Min_detection"
                  type="int">minumum number of frames with at least one detection before sending results</input_port>
      <input_port name="Confidence"
                  default="0.600000"
                  type="float">Ai confidence</input_port>
      <input_port name="Object_class"
                  type="std::string">Searched object</input_port>
      <input_port name="Max_size_output"
                  type="int">Max size of the output array</input_port>
      <input_port name="Camera"
                  default="1"
                  type="int">0: Front, 1: Bottom</input_port>
    </Action>
    <Action ID="ControlSetMode">
      <input_port name="set_mode"
                  default="false"
                  type="bool"/>
    </Action>
    <Action ID="EnableDisableDVL">
      <input_port name="dvl_input"
                  default="false"
                  type="bool">true: start, false: stop</input_port>
    </Action>
    <Action ID="InitializeTrajectory">
      <output_port name="trajectory"
                   type="Trajectory"/>
    </Action>
    <Condition ID="MissionSwitchStatus"/>
    <SubTree ID="MoveSinglePose"
             editable="true">
      <input_port name="positionX"
                  default="0.0"/>
      <input_port name="positionY"
                  default="0.0"/>
      <input_port name="positionZ"
                  default="0.0"/>
      <input_port name="orientationX"
                  default="0.0"/>
      <input_port name="orientationY"
                  default="0.0"/>
      <input_port name="orientationZ"
                  default="0.0"/>
      <input_port name="frame"
                  default="1.0"/>
    </SubTree>
    <Action ID="SendTrajectory">
      <input_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="interpolation"
                  default="0"
                  type="int"/>
    </Action>
    <Action ID="Tare">
      <input_port name="sensor"
                  type="std::string">imu or depth</input_port>
    </Action>
    <Action ID="Torpedo">
      <input_port name="side"
                  type="std::string">port_side or starboard</input_port>
    </Action>
    <Action ID="TrajectoryAppendPose">
      <input_port name="precision"
                  default="0"
                  type="int"/>
      <input_port name="speed"
                  default="0"
                  type="int"/>
      <input_port name="orientationZ"
                  default="0.000000"
                  type="float"/>
      <input_port name="orientationY"
                  default="0.000000"
                  type="float"/>
      <input_port name="orientationX"
                  default="0.000000"
                  type="float"/>
      <input_port name="frame"
                  default="1"
                  type="int"/>
      <input_port name="positionZ"
                  default="0.000000"
                  type="float"/>
      <inout_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="longRotation"
                  default="false"
                  type="bool"/>
      <input_port name="positionY"
                  default="0.000000"
                  type="float"/>
      <input_port name="positionX"
                  default="0.000000"
                  type="float"/>
    </Action>
    <Action ID="WaitTargetReached">
      <input_port name="timeout"
                  default="5"
                  type="int"/>
    </Action>
  </TreeNodesModel>

</root>
