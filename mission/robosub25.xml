      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="1.1"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="1.1"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1.0"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="1.1"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1.0"/>
