  <BehaviorTree ID="gate">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <SubTree ID="coin_flip"/>
      <TrajectoryAppendPose trajectory=""
                            precision="0"
                            speed="0"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="0.000000"
                            positionX="1.5"/>
      <SubTree ID="trickshot"/>
      <TrajectoryAppendPose trajectory=""
                            precision="0"
                            speed="0"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="0.000000"
                            positionX="1"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="gate_solo">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
