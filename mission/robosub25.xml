                Confidence="0.4"
                Max_size_output="5"
                Max_depth="200"
                Object_class="gate-shark"
                Max_frame="20"
                Camera="1"/>
      <Alignment lateral_m="{lateral_m}"
                 alignement_by_translation="{choix_translation}"
                 has_metric="{has_metric}"
                 alpha="0.5"
                 normalized_coords="0"
                 norm_x="{norm_x}"
                 bearing_rad="{bearing_rad}"
                 traj="{traj}"
                 detections="{detect_array}"/>
      <SendTrajectory trajectory="{traj}"
                      interpolation="0"/>
      <WaitTargetReached timeout="5"/>
      <SubTree ID="MoveSinglePose"
               positionX="3.5"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1.0"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="gate_step">
    <Sequence>
      <SubTree ID="coin_flip"/>
      <SubTree ID="gate_solo"
               choix_translation="true"/>
      <SubTree ID="trickshot_legacy"/>
      <SubTree ID="MoveSinglePose"
               positionX="0.0"
               positionY="0.0"
               positionZ="-0.5"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"
               frame="1.0"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="run25">
    <Sequence>
      <AiActivation Model="0"
                    Bottom="false"
                    Front="true"/>
      <SubTree ID="gate_step"/>
      <SubTree ID="torpedo_step"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="search_rot">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <Fallback>
        <AiFilter detected_object_array="{detect_array}"
                  Min_detection="1"
                  Confidence="0.600000"
                  Max_size_output="1"
                  Max_depth="25"
                  Object_class="{object_class}"
                  Max_frame="5"
                  Camera="1"/>
        <Sequence>
          <SubTree ID="MoveSinglePose"
                   positionX="0.0"
                   positionY="0.0"
                   positionZ="0.0"
                   orientationX="0.0"
                   orientationY="0.0"
                   orientationZ="30"
                   frame="1.0"/>
          <Fallback>
            <AiFilter detected_object_array="{detect_array}"
                      Min_detection="1"
                      Confidence="0.600000"
                      Max_size_output="1"
                      Max_depth="25"
                      Object_class="{object_class}"
                      Max_frame="5"
                      Camera="1"/>
            <Sequence>
              <SubTree ID="MoveSinglePose"
                       positionX="0.0"
                       positionY="0.0"
                       positionZ="0.0"
                       orientationX="0.0"
                       orientationY="0.0"
                       orientationZ="30"
                       frame="1.0"/>
              <Fallback>
                <AiFilter detected_object_array="{detect_array}"
                          Min_detection="1"
                          Confidence="0.600000"
                          Max_size_output="1"
                          Max_depth="25"
                          Object_class="{object_class}"
                          Max_frame="5"
                          Camera="1"/>
                <Sequence>
                  <SubTree ID="MoveSinglePose"
                           positionX="0.0"
                           positionY="0.0"
                           positionZ="0.0"
                           orientationX="0.0"
                           orientationY="0.0"
                           orientationZ="-90"
                           frame="1.0"/>
                  <Fallback>
                    <AiFilter detected_object_array="{detect_array}"
                              Min_detection="1"
                              Confidence="0.600000"
                              Max_size_output="1"
                              Max_depth="25"
                              Object_class="{object_class}"
                              Max_frame="5"
                              Camera="1"/>
                    <Sequence>
                      <SubTree ID="MoveSinglePose"
                               positionX="0.0"
                               positionY="0.0"
                               positionZ="0.0"
                               orientationX="0.0"
                               orientationY="0.0"
                               orientationZ="-30"
                               frame="1.0"/>
                      <AiFilter detected_object_array=""
                                Min_detection="1"
                                Confidence="0.600000"
                                Max_size_output="1"
                                Max_depth="25"
                                Object_class="{object_class}"
                                Max_frame="5"
                                Camera="1"/>
                    </Sequence>
                  </Fallback>
                </Sequence>
              </Fallback>
            </Sequence>
          </Fallback>
        </Sequence>
      </Fallback>
    </Sequence>
  </BehaviorTree>

