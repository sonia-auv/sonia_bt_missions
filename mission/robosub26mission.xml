<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="Run26">
  <BehaviorTree ID="Bin">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <SubTree ID="SearchObjectByRotation"
               StartingAngle="0"
               Object="bin"
               FoundAiDetection="{Aidetection}"/>
      <RotateToMission trajectory="{Trajectory}"
                       detections="{Aidetection}"/>
      <MoveToMission trajectory="{Trajectory}"
                     detections="{Aidetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailling="5"/>
      <Dropper side="port_side"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="CoinFlip">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <SubTree ID="MoveSinglePose"
               frame="1.0"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.5"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"/>
      <SubTree ID="MoveSinglePose"
               frame="2.0"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Gate">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <AiActivation Model="0"
                    Bottom="false"
                    Front="true"/>
      <InitializeTrajectory trajectory="{Trajectory}"/>
      <SubTree ID="SearchObjectByRotation"
               StartingAngle="0"
               Object="gate-shark"
               FoundAiDetection="{Aidetection}"/>
      <RotateToMission trajectory="{Trajectory}"
                       detections="{Aidetection}"/>
      <MoveToMission trajectory="{Trajectory}"
                     detections="{AiDetection}"/>
      <SubTree ID="SendTrajectoryOnly"
               Trajectory="{Trajectory}"
               TimeBeforeFailling="7"/>
      <SubTree ID="RotateToAbsoluteAngle"
               Angle="0"/>
      <SubTree ID="MoveSinglePose"
               frame="1.0"
               positionX="0.5"
               positionY="0.0"
               positionZ="0.0"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Octogon">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Run26">
    <Sequence>
      <SubTree ID="CoinFlip"/>
      <SubTree ID="Gate"/>
      <SubTree ID="TrickshotLegacy"/>
      <SubTree ID="Bin"
               HintAngle="0"/>
      <SubTree ID="Torpedoes"
               HintAngle="0"/>
      <SubTree ID="Octogon"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="Torpedoes">
    <AlwaysSuccess/>
  </BehaviorTree>

  <BehaviorTree ID="Trickshot">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <SubTree ID="MoveSinglePose"
               frame="4"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.75"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"/>
      <InitializeTrajectory trajectory="{traj}"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="90"
                            orientationX="0"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="0"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="0180"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="180"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="0.000000"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="180"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="0"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="0"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="-180"
                            orientationX="0"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="0"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="-90"
                            orientationX="0"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="2"
                            frame="1"
                            orientationZ="0"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="180"
                            positionX="0.000000"/>
      <SendTrajectory trajectory="{traj}"
                      interpolation="0"/>
      <WaitTargetReached timeout="10"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="TrickshotLegacy">
    <Sequence>
      <RetryUntilSuccessful num_attempts="-1">
        <MissionSwitchStatus/>
      </RetryUntilSuccessful>
      <SubTree ID="MoveSinglePose"
               frame="1"
               positionX="0.0"
               positionY="0.0"
               positionZ="0.5"
               orientationX="0.0"
               orientationY="0.0"
               orientationZ="0.0"/>
      <InitializeTrajectory trajectory="{traj}"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="0"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="90"
                            orientationX="0.000000"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="0"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="180"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="0"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="0.000000"
                            orientationX="180"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="0"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="90"
                            orientationX="0.000000"
                            positionX="0.000000"/>
      <TrajectoryAppendPose trajectory="{traj}"
                            precision="0"
                            speed="0"
                            frame="1"
                            orientationZ="0.000000"
                            longRotation="false"
                            positionZ="0.000000"
                            positionY="0.000000"
                            orientationY="180"
                            orientationX="0.000000"
                            positionX="0.000000"/>
      <SendTrajectory trajectory="{traj}"
                      interpolation="0"/>
      <WaitTargetReached timeout="10"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="AiActivation">
      <input_port name="Model"
                  default="0"
                  type="int">model choice, default = 0</input_port>
      <input_port name="Bottom"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
      <input_port name="Front"
                  default="false"
                  type="bool">true: ON, talse: OFF</input_port>
    </Action>
    <SubTree ID="Bin"
             editable="true">
      <input_port name="HintAngle"
                  default="0">The approximation of the angle where the mission is.</input_port>
    </SubTree>
    <Action ID="Dropper">
      <input_port name="side"
                  type="std::string">port_side or starboard</input_port>
    </Action>
    <Action ID="InitializeTrajectory">
      <output_port name="trajectory"
                   type="Trajectory"/>
    </Action>
    <Condition ID="MissionSwitchStatus"/>
    <SubTree ID="MoveSinglePose"
             editable="true">
      <input_port name="frame"
                  default="1.0">Submarine reference type</input_port>
      <input_port name="positionX"
                  default="0.0">x value to go</input_port>
      <input_port name="positionY"
                  default="0.0">y value to go</input_port>
      <input_port name="positionZ"
                  default="0.0">z value to go</input_port>
      <input_port name="orientationX"
                  default="0.0">z orientation to go</input_port>
      <input_port name="orientationY"
                  default="0.0">y orientation to go</input_port>
      <input_port name="orientationZ"
                  default="0.0">x orientation to go</input_port>
    </SubTree>
    <Action ID="MoveToMission">
      <inout_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="detections"
                  type="AiDetectionArray"/>
    </Action>
    <SubTree ID="RotateToAbsoluteAngle"
             editable="true">
      <input_port name="Angle"
                  default="0">Angle to position the sub with the pool</input_port>
    </SubTree>
    <Action ID="RotateToMission">
      <inout_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="detections"
                  type="AiDetectionArray"/>
    </Action>
    <SubTree ID="SearchObjectByRotation"
             editable="true">
      <input_port name="StartingAngle"
                  default="0">Angle to give to the sub at the begining of the searching procedure</input_port>
      <input_port name="Object">The name of the object to search</input_port>
      <output_port name="FoundAiDetection">The detection of the ai if he found the object</output_port>
    </SubTree>
    <Action ID="SendTrajectory">
      <input_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="interpolation"
                  default="0"
                  type="int"/>
    </Action>
    <SubTree ID="SendTrajectoryOnly"
             editable="true">
      <input_port name="Trajectory">The trajectory to do to the sub</input_port>
      <input_port name="TimeBeforeFailling"
                  default="5">The time before the sub movement fail</input_port>
    </SubTree>
    <SubTree ID="Torpedoes"
             editable="true">
      <input_port name="HintAngle"
                  default="0">The approximation of the angle where the torpideos is.</input_port>
    </SubTree>
    <Action ID="TrajectoryAppendPose">
      <inout_port name="trajectory"
                  type="Trajectory"/>
      <input_port name="precision"
                  default="0"
                  type="int"/>
      <input_port name="speed"
                  default="0"
                  type="int"/>
      <input_port name="frame"
                  default="1"
                  type="int"/>
      <input_port name="orientationZ"
                  default="0.000000"
                  type="float"/>
      <input_port name="longRotation"
                  default="false"
                  type="bool"/>
      <input_port name="positionZ"
                  default="0.000000"
                  type="float"/>
      <input_port name="positionY"
                  default="0.000000"
                  type="float"/>
      <input_port name="orientationY"
                  default="0.000000"
                  type="float"/>
      <input_port name="orientationX"
                  default="0.000000"
                  type="float"/>
      <input_port name="positionX"
                  default="0.000000"
                  type="float"/>
    </Action>
    <Action ID="WaitTargetReached">
      <input_port name="timeout"
                  default="5"
                  type="int"/>
    </Action>
  </TreeNodesModel>

</root>
